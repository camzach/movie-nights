<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.colors.min.css">
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
    <style>
      main {
        display: flex;
        flex-direction: column;
        padding: 3rem;
        gap: 3rem;
      }
      @media (min-width: 1326px) {
        main {
          flex-direction: row;
        }
      }
      details label {
        &:has(input:not(:checked)) {
          display: none;
        }
        &:has([value="on"]) {
          background-color: var(--pico-color-green-500);
        }
        &:has([value="off"]) {
          background-color: var(--pico-color-red-500);
        }
        input {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <dialog>
      <span></span>
      <form>
        <button
          type="submit"
          id="watch"
          hx-post="/movies/watch"
          hx-vals="javascript:{'imdb_id': wheel.items[choice].value.imdb_id}"
          hx-target="tr[data-spun]"
          hx-swap="delete"
          hx-on::after-on-load="document.querySelector('dialog').close()"
        >
          Watch
        </button>
        <button
          type="submit"
          id="veto"
          hx-post="/movies/veto"
          hx-vals="javascript:{'imdb_id': wheel.items[choice].value.imdb_id}"
          hx-target="tr[data-spun] td[data-vetos]"
          hx-swap="textContent"
          hx-on::after-on-load="document.querySelector('dialog').close()"
        >
          Veto
        </button>
      </form>
    </dialog>
    <main>
      <div id="wheel"></div>
      <details>
        <summary>Genre Filters</summary>
        {{#each this.[1]}}
          <label role="button">{{this}} ON<input type="radio" value="on" name="{{this}}"></label>
          <label role="button">{{this}} OFF<input type="radio" value="off" name="{{this}}"></label>
          <label role="button">{{this}} ANY<input type="radio" value="any" name="{{this}}" checked></label>
        {{/each}}
      </details>
      <div>
        {{> movie-table this.[0]}}
        <form
          hx-post="/movies"
          hx-target="#list tbody"
          hx-swap="beforeend"
        >
          <fieldset class="grid">
            <label>Your Name<input type="text" name="proposed_by" placeholder="Your Name"></label>
            <label>IMDb ID or Link<input type="text" name="imdb_id" placeholder="IMDb ID"></label>
          </fieldset>
          <input type="submit" value="Submit Movie">
        </form>
      </div>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/spin-wheel@5.0.1/dist/spin-wheel-iife.js"></script>
    <script>
      const pointerCanvas = document.createElement('canvas');
      pointerCanvas.height = 300;
      pointerCanvas.width = 300;
      const ctx = pointerCanvas.getContext('2d');
      ctx.beginPath();
      ctx.fillStyle='red';
      ctx.moveTo(275,150);
      ctx.lineTo(300,137.5);
      ctx.lineTo(300,163.5);
      ctx.fill();
      const pointer = new Image()
      pointer.src = pointerCanvas.toDataURL();

      const { Wheel } = spinWheel;

      let wheel, choice;

      function newWheel() {
        const newWheel = document.createElement('div');
        newWheel.id = 'wheel';
        document.querySelector('#wheel').replaceWith(newWheel);
        const items = Array.from(document.querySelectorAll('tbody tr:not([hidden])'), (item) => {
          const [title, year, director, genre, proposed_by, proposed_on, vetos] = Array.from(item.querySelectorAll('td'), i => i.innerText);
          const imdb_id = item.getAttribute('data-imdb-id');
          return { title, year, director, genre, proposed_by, proposed_on, vetos, imdb_id };
        })
        wheel = new Wheel(newWheel, {
          items: items.map(item => ({
            label: `${item.title} (${item.year})`,
            value: item,
            backgroundColor: `hsl(${Math.random() * 360}deg 100% 50%)`,
          })),
          isInteractive: false,
          pointerAngle: 90,
          overlayImage: pointer
        });
        newWheel.addEventListener('click', () => {
          let row = document.querySelector(`tr[data-imdb-id=${wheel.items[choice]?.value.imdb_id}]`);
          if (row) {
            row.removeAttribute('data-spun');
          }
          choice = Math.floor(Math.random() * wheel.items.length);
          wheel.spinToItem(choice, 3000, false, Math.floor(Math.random() * 3) + 1);
          row = document.querySelector(`tr[data-imdb-id=${wheel.items[choice].value.imdb_id}]`);
          row.setAttribute('data-spun', true);
        });
        wheel.onRest = () => {
          document.querySelector('dialog span').innerText = wheel.items[choice].label;
          document.querySelector('#veto').disabled = wheel.items[choice].value.vetos >= 3;
          document.querySelector('dialog').showModal();
        }
      }
      let observer = new MutationObserver(newWheel);
      observer.observe(document.querySelector('table'), { subtree: true, childList: true, attributes: true, attributeFilter: ['hidden'] });
      newWheel();

      document.querySelector('dialog').addEventListener('cancel', e => e.preventDefault());

      let hiddenGenres = new Set();
      let requiredGenres = new Set();

      function filterMovie(genres) {
        if (genres.some(genre => hiddenGenres.has(genre))) {
          return false;
        }
        if (![...requiredGenres].every(genre => genres.includes(genre))) {
          return false;
        }
        return true;
      }

      document.querySelectorAll('details input').forEach(input => {
        let genre = input.name;
        let value = input.value;
        let nextValue = {
          'on': 'off',
          'off': 'any',
          'any': 'on'
        }[value];
        input.addEventListener('click', (e) => {
          e.preventDefault();
          e.target.checked = false;
          document.querySelector(`input[name=${genre}][value=${nextValue}]`).checked = true;
          if (value === 'on') {
            hiddenGenres.add(genre);
            requiredGenres.delete(genre);
          } else if (value === 'off') {
            hiddenGenres.delete(genre)
          } else {
            requiredGenres.add(genre);
          }
          document.querySelectorAll('tbody tr').forEach((row,i) => {
            const genres = row.querySelector('td:nth-child(4)').textContent.split(', ');
            const show = filterMovie(genres);
            row.hidden = !show;
          });
        });
      });
    </script>
  </body>
</html>
