<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.colors.min.css"
    >
    <style>
      main {
        display: flex;
        flex-direction: column;
        padding: 3rem;
        gap: 3rem;
      }
      @media (min-width: 1326px) {
        main {
          flex-direction: row;
        }
      }
      details label {
        &:has(input:not(:checked)) {
          display: none;
        }
        &:has([value="on"]) {
          background-color: var(--pico-color-green-500);
        }
        &:has([value="off"]) {
          background-color: var(--pico-color-red-500);
        }
        input {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <dialog>
      <span></span>
      <button id="watch" onclick="watch()">Watch</button>
      <button id="veto" onclick="veto()">Veto</button>
    </dialog>
    <main>
      <div id="wheel"></div>
      <details>
        <summary>Genre Filters</summary>
        {{#each this.[1]}}
          <label role="button">{{this}} ON<input type="radio" value="on" name="{{this}}"></label>
          <label role="button">{{this}} OFF<input type="radio" value="off" name="{{this}}"></label>
          <label role="button">{{this}} ANY<input type="radio" value="any" name="{{this}}" checked></label>
        {{/each}}
      </details>
      <div>
        <table id="list">
          <thead>
            <tr>
              <th>Title</th>
              <th>Year</th>
              <th>Director</th>
              <th>Genre</th>
              <th>Proposed By</th>
              <th>Proposed On</th>
              <th>Times Vetoed</th>
            </tr>
          </thead>
          <tbody>
            {{#each this.[0]}}
              <tr data-imdb-id="{{this.db_info.imdb_id}}">
                <td>{{this.api_info.title}}</td>
                <td>{{this.api_info.year}}</td>
                <td>{{this.api_info.director}}</td>
                <td>{{this.api_info.genre}}</td>
                <td>{{this.db_info.proposed_by}}</td>
                <td>{{formatDate this.db_info.proposed_at}}</td>
                <td>{{this.db_info.vetos}}</td>
              </tr>
            {{/each}}
          </tbody>
        </table>
        <form action="" onsubmit="return false;">
          <fieldset class="grid">
            <label>Your Name<input type="text" name="proposed_by" placeholder="Your Name"></label>
            <label>IMDb ID or Link<input type="text" name="imdb_id" placeholder="IMDb ID"></label>
          </fieldset>
          <input type="submit" value="Submit Movie">
        </form>
      </div>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/spin-wheel@5.0.1/dist/spin-wheel-iife.js"></script>
    <script>
      const pointerCanvas = document.createElement('canvas');
      pointerCanvas.height = 300;
      pointerCanvas.width = 300;
      const ctx = pointerCanvas.getContext('2d');
      ctx.beginPath();
      ctx.fillStyle='red';
      ctx.moveTo(275,150);
      ctx.lineTo(300,137.5);
      ctx.lineTo(300,163.5);
      ctx.fill();
      const pointer = new Image()
      pointer.src = pointerCanvas.toDataURL();

      const { Wheel } = spinWheel;

      const allItems = [
        {{ #each this.[0] }}
        {
          label: "{{this.api_info.title}} ({{this.api_info.year}})",
          value: {{{toJSON this}}},
          backgroundColor: `hsl(${Math.random() * 360}deg 100% 50%)`,
        },
        {{/each }}
      ];
      
      let wheel = new Wheel(document.querySelector('#wheel'), {
        items: allItems,
        isInteractive: false,
        pointerAngle: 90,
        overlayImage: pointer
      });

      let choice;
      document.querySelector('#wheel').addEventListener('click', () => {
        choice = Math.floor(Math.random() * wheel.items.length);
        wheel.spinToItem(choice, 3000, false, Math.floor(Math.random() * 3) + 1)
      });

      wheel.onRest = () => {
        document.querySelector('dialog span').innerText = wheel.items[choice].label;
        document.querySelector('#veto').disabled = wheel.items[choice].value.db_info.vetos >= 3;
        document.querySelector('dialog').showModal();
      }

      document.querySelector('dialog').addEventListener('cancel', e => e.preventDefault());

      function replaceWheel(items) {
        const newWheel = document.createElement('div');
        newWheel.id = 'wheel';
        document.querySelector('#wheel').replaceWith(newWheel)
        wheel = new Wheel(newWheel, {
          items: items ?? allItems,
          isInteractive: false,
          pointerAngle: 90,
          overlayImage: pointer
        });
        newWheel.addEventListener('click', () => {
          choice = Math.floor(Math.random() * wheel.items.length);
          wheel.spinToItem(choice, 3000, false, Math.floor(Math.random() * 3) + 1)
        });
        wheel.onRest = () => {
          document.querySelector('dialog span').innerText = wheel.items[choice].label;
          document.querySelector('#veto').disabled = wheel.items[choice].value.db_info.vetos >= 3;
          document.querySelector('dialog').showModal();
        }
      }

      function watch() {
        const thisItem = wheel.items[choice].value;
        fetch("/movies/watch", {
          method: "POST",
          body: new URLSearchParams({ imdb_id: thisItem.db_info.imdb_id })
        }).then(() => {
          const idx = allItems.findIndex(i => i.value.db_info.imdb_id === thisItem.db_info.imdb_id);
          allItems.splice(idx, 1);
          replaceWheel();
          document.querySelector('tr[data-imdb-id="' + thisItem.db_info.imdb_id + '"] td:nth-child(7)').remove();
          document.querySelector('dialog').close();
        })
      }

      function veto() {
        const thisItem = wheel.items[choice].value;
        fetch("/movies/veto", {
          method: "POST",
          body: new URLSearchParams({ imdb_id: thisItem.value.db_info.imdb_id })
        }).then(() => {
          thisItem.db_info.vetos += 1;
          document.querySelector('tr[data-imdb-id="' + thisItem.db_info.imdb_id + '"] td:nth-child(7)').innerText = thisItem.db_info.vetos;
          document.querySelector('dialog').close();
        });
      }

      function newMovie() {
        const formData = new FormData(document.querySelector('form'));
        fetch("/movies", {
          method: "POST",
          body: new URLSearchParams(formData),
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
        })
          .then(res => res.json())
          .then(json => {
            let newItem = json.find(el => el.db_info.imdb_id === formData.get('imdb_id'));
            allItems.push({
              label: `${newItem.api_info.title} (${newItem.api_info.year})`,
              value: newItem,
              backgroundColor: `hsl(${Math.random() * 360}deg 100% 50%)`,
            });
            replaceWheel();
            let row = document.createElement('tr');
            const title = document.createElement('td');
            title.innerText = newItem.api_info.title;
            row.appendChild(title);
            const year = document.createElement('td');
            year.innerText = newItem.api_info.year;
            row.appendChild(year);
            const director = document.createElement('td');
            director.innerText = newItem.api_info.director;
            row.appendChild(director);
            const genre = document.createElement('td');
            genre.innerText = newItem.api_info.genre;
            row.appendChild(genre);
            const proposed_by = document.createElement('td');
            proposed_by.innerText = newItem.db_info.proposed_by;
            row.appendChild(proposed_by);
            const proposed_at = document.createElement('td');
            proposed_at.innerText = formatDate(newItem.db_info.proposed_at);
            row.appendChild(proposed_at);
            const vetos = document.createElement('td');
            vetos.innerText = newItem.db_info.vetos;
            row.appendChild(vetos);
            document.querySelector('table tbody').appendChild(row);
          });
      }
      document.querySelector('form [type=submit]').addEventListener('click', newMovie);

      function formatDate(date) {
        date = new Date(date * 1000);
        let month = date.getMonth() + 1;
        if (month < 10) {
          month = '0' + month.toString();
        }
        let day = date.getDate();
        if (day < 10) {
          day = '0' + day.toString();
        }
        const year = date.getFullYear();
        return `${month}/${day}/${year}`;
      }

      let hiddenGenres = new Set();
      let requiredGenres = new Set();

      function filterMovie(genres) {
        if (genres.some(genre => hiddenGenres.has(genre))) {
          return false;
        }
        if (![...requiredGenres].every(genre => genres.includes(genre))) {
          return false;
        }
        return true;
      }

      document.querySelectorAll('details input').forEach(input => {
        let genre = input.name;
        let value = input.value;
        let nextValue = {
          'on': 'off',
          'off': 'any',
          'any': 'on'
        }[value];
        input.addEventListener('click', (e) => {
          e.preventDefault();
          e.target.checked = false;
          document.querySelector(`input[name=${genre}][value=${nextValue}]`).checked = true;
          if (value === 'on') {
            hiddenGenres.add(genre);
            requiredGenres.delete(genre);
          } else if (value === 'off') {
            hiddenGenres.delete(genre)
          } else {
            requiredGenres.add(genre);
          }
          replaceWheel(allItems.filter(item => {
            const genres = item.value.api_info.genre.split(', ');
            return filterMovie(genres);
          }));
          document.querySelectorAll('tbody tr').forEach((row,i) => {
            console.log(allItems, i, allItems[i]);
            const genres = allItems[i].value.api_info.genre.split(', ');
            console.log(requiredGenres, hiddenGenres, genres);
            const show = filterMovie(genres);
            row.hidden = !show;
          });
        });
      });
    </script>
  </body>
</html>
