<tr data-imdb-id="{{this.db_info.imdb_id}}">
  <td data-title="">{{this.api_info.title}}</td>
  <td data-year="">{{this.api_info.year}}</td>
  <td data-director="">{{this.api_info.director}}</td>
  <td data-genre="">{{this.api_info.genre}}</td>
  <td>{{this.db_info.proposed_by}}</td>
  <td>{{formatDate this.db_info.proposed_at}}</td>
  <td data-vetos="">{{this.db_info.vetos}}</td>
</tr>
